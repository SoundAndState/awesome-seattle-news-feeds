{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "awesome-seattle-feed-proxy",
  "main": "../proxy/worker.mjs",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "cache": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://soundandstate.com,https://sayhiben.github.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173"
  },
  "ratelimits": [
    {
      "name": "FEED_LIMITER",
      "namespace_id": "20260915",
      "simple": {
        "limit": 240,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "kv_namespaces": [
    {
      "binding": "FEED_SNAPSHOTS",
      "id": "e20c7a99ffb94842b611122997d2b46b"
    }
  ]
}
