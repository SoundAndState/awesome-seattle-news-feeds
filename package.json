{
  "name": "awesome-seattle-news-feeds",
  "version": "1.0.0",
  "private": true,
  "description": "A curated directory of Seattle and Washington news feeds, built from JSON.",
  "type": "module",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "check:agents": "python scripts/check_agent_guidance.py",
    "validate": "node scripts/validate.mjs",
    "lint:readme": "awesome-lint readme.md",
    "lint:opml": "node scripts/validate-opml.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:web": "vite build --config config/vite.config.mjs",
    "preview": "vite preview --config config/vite.config.mjs --host 127.0.0.1 --port 4173",
    "test:browser": "node scripts/browser-tests.mjs test --config config/playwright.config.mjs",
    "check:proxy": "wrangler deploy --config config/wrangler.jsonc --dry-run",
    "deploy:proxy": "node scripts/deploy-proxy.mjs",
    "ci": "npm run build && npm run check && npm run validate && npm run lint:readme && npm run lint:opml && npm test && npm run build:web",
    "check:feeds": "python scripts/check_feeds.py",
    "test:browser:install": "node scripts/browser-tests.mjs install chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "awesome-lint": "2.3.0",
    "fast-xml-parser": "5.11.1",
    "vite": "8.3.0",
    "wrangler": "4.132.0"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "dompurify": "3.4.15",
    "feedsmith": "2.9.6"
  }
}
