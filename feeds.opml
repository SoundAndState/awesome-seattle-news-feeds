    <outline text="Washington State" title="Washington State">
      <outline type="rss" text="KREM 2 Local" title="KREM 2 Local" description="Television newsroom reporting on Spokane and the Inland Northwest, including nearby Idaho." xmlUrl="https://www.krem.com/feeds/syndication/rss/news/local" htmlUrl="https://www.krem.com"/>
      <outline type="rss" text="Washington State Standard" title="Washington State Standard" description="State government, elections, public policy, and accountability reporting." xmlUrl="https://washingtonstatestandard.com/feed/" htmlUrl="https://washingtonstatestandard.com"/>
