      <outline type="rss" text="My Lynnwood News" title="My Lynnwood News" description="Community reporting, local government, and events from the publication formerly called Lynnwood Today." xmlUrl="https://mylynnwoodnews.com/feed/" htmlUrl="https://mylynnwoodnews.com"/>
      <outline type="rss" text="The Everett Herald" title="The Everett Herald" description="Snohomish County reporting, regional news, and local sports." xmlUrl="https://www.heraldnet.com/feed/" htmlUrl="https://www.heraldnet.com"/>
