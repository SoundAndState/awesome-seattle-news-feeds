<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated from feeds.json. Run npm run build. -->
<opml version="2.0">
  <head>
    <title>Awesome Seattle News Feeds</title>
  </head>
  <body>
    <outline text="Seattle and Regional Reporting" title="Seattle and Regional Reporting">
      <outline type="rss" text="Cascade PBS News" title="Cascade PBS News" description="Regional public-media journalism and analysis, using the news feed instead of television-program listings." xmlUrl="https://www.cascadepbs.org/articles/rss/" htmlUrl="https://www.cascadepbs.org/news"/>
      <outline type="rss" text="Converge Media" title="Converge Media" description="Local reporting, interviews, and cultural coverage centered on Seattle-area Black communities." xmlUrl="https://www.whereweconverge.com/post?format=rss" htmlUrl="https://www.whereweconverge.com/post"/>
      <outline type="rss" text="HardPressed" title="HardPressed" description="Independent Seattle-area investigations and public-records reporting." xmlUrl="https://www.hardpressed-info.com/rss/" htmlUrl="https://www.hardpressed-info.com"/>
      <outline type="rss" text="KING 5 Local" title="KING 5 Local" description="Television newsroom reporting on Seattle and Western Washington from the local section." xmlUrl="https://www.king5.com/feeds/syndication/rss/news/local" htmlUrl="https://www.king5.com"/>
      <outline type="rss" text="MyNorthwest Local" title="MyNorthwest Local" description="Regional radio-news reporting and commentary using the local section feed." xmlUrl="https://mynorthwest.com/local/feed" htmlUrl="https://mynorthwest.com/local"/>
      <outline type="rss" text="Northwest Asian Weekly" title="Northwest Asian Weekly" description="Reporting on Asian American communities in Seattle and the Pacific Northwest, plus broader community issues." xmlUrl="https://nwasianweekly.com/feed/" htmlUrl="https://nwasianweekly.com"/>
      <outline type="rss" text="PubliCola" title="PubliCola" description="Independent reporting and analysis on city government, housing, transportation, and public policy." xmlUrl="https://publicola.com/feed/" htmlUrl="https://publicola.com"/>
      <outline type="rss" text="Real Change" title="Real Change" description="Local reporting and commentary on homelessness, poverty, housing, and social justice." xmlUrl="https://www.realchangenews.org/rss.xml" htmlUrl="https://www.realchangenews.org"/>
      <outline type="rss" text="Seattle Weekly" title="Seattle Weekly" description="Local and regional reporting, community stories, and entertainment." xmlUrl="https://www.seattleweekly.com/feed/" htmlUrl="https://www.seattleweekly.com"/>
      <outline type="rss" text="The Bulletin" title="The Bulletin" description="Independent reporting and analysis on Seattle Public Schools and education." xmlUrl="https://thebulletinsea.org/rss/" htmlUrl="https://thebulletinsea.org"/>
      <outline type="rss" text="The Burner" title="The Burner" description="Independent Seattle-area reporting and commentary on government and public accountability." xmlUrl="https://www.theburnerseattle.com/blog-feed.xml" htmlUrl="https://www.theburnerseattle.com"/>
      <outline type="rss" text="The Seattle Medium" title="The Seattle Medium" description="Local reporting on Seattle-area Black communities, using the local-news section feed." xmlUrl="https://seattlemedium.com/category/local-news/feed/" htmlUrl="https://seattlemedium.com/category/local-news"/>
      <outline type="rss" text="The Seattle Times Local Politics" title="The Seattle Times Local Politics" description="Seattle and Washington government, elections, and civic affairs; the preferred narrower local feed." xmlUrl="https://www.seattletimes.com/seattle-news/politics/feed/" htmlUrl="https://www.seattletimes.com/seattle-news/politics"/>
      <outline type="rss" text="The Stranger" title="The Stranger" description="Alternative local reporting, arts, and progressive commentary, with some national coverage." xmlUrl="https://www.thestranger.com/feed/" htmlUrl="https://www.thestranger.com"/>
    </outline>
    <outline text="Seattle Neighborhoods" title="Seattle Neighborhoods">
      <outline type="rss" text="Capitol Hill Seattle Blog" title="Capitol Hill Seattle Blog" description="Neighborhood reporting on Capitol Hill and nearby central Seattle communities." xmlUrl="https://www.capitolhillseattle.com/feed/" htmlUrl="https://www.capitolhillseattle.com"/>
      <outline type="rss" text="Fremont Neighbor" title="Fremont Neighbor" description="Local reporting and neighborhood developments in Fremont." xmlUrl="https://fremontneighbor.com/feed/" htmlUrl="https://fremontneighbor.com"/>
