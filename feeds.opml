      <outline type="rss" text="Northwest Asian Weekly" title="Northwest Asian Weekly" description="News and community coverage serving Asian American and Pacific Islander communities in Washington." xmlUrl="https://nwasianweekly.com/feed/" htmlUrl="https://nwasianweekly.com"/>
      <outline type="rss" text="PubliCola" title="PubliCola" description="Reader-supported reporting, analysis, and commentary on Seattle-area government, housing, transportation, and public policy." xmlUrl="https://publicola.com/feed/" htmlUrl="https://publicola.com"/>
      <outline type="rss" text="Real Change" title="Real Change" description="Local reporting and commentary on housing, poverty, and social justice from a Seattle newspaper supporting vendor income." xmlUrl="https://www.realchangenews.org/rss.xml" htmlUrl="https://www.realchangenews.org"/>
