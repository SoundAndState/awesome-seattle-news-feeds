    <outline text="Transportation and Urbanism" title="Transportation and Urbanism">
      <outline type="rss" text="Seattle Bike Blog" title="Seattle Bike Blog" description="Local cycling news, street safety reporting, and bicycle advocacy." xmlUrl="https://www.seattlebikeblog.com/feed/" htmlUrl="https://www.seattlebikeblog.com"/>
      <outline type="rss" text="Seattle Transit Blog" title="Seattle Transit Blog" description="Regional transit reporting, service changes, and transit advocacy." xmlUrl="https://seattletransitblog.com/feed/" htmlUrl="https://seattletransitblog.com"/>
      <outline type="rss" text="The Seattle Times Traffic Lab" title="The Seattle Times Traffic Lab" description="Regional transportation reporting on roads, transit, and travel policy." xmlUrl="https://www.seattletimes.com/transportation/feed/" htmlUrl="https://www.seattletimes.com/seattle-news/transportation"/>
      <outline type="rss" text="The Urbanist" title="The Urbanist" description="Housing and transportation reporting alongside pro-transit and pro-density commentary." xmlUrl="https://www.theurbanist.org/rss/" htmlUrl="https://www.theurbanist.org"/>
    </outline>
    <outline text="Food Culture and History" title="Food Culture and History">
      <outline type="rss" text="Eater Seattle" title="Eater Seattle" description="Restaurant news, dining guides, and food coverage for the Seattle area." xmlUrl="https://seattle.eater.com/rss/index.xml" htmlUrl="https://seattle.eater.com"/>
      <outline type="rss" text="Seattle Met Eat and Drink" title="Seattle Met Eat and Drink" description="Regional restaurant coverage, dining guides, and food-related features." xmlUrl="https://www.seattlemet.com/eat-and-drink/feed?format=atom" htmlUrl="https://www.seattlemet.com/eat-and-drink"/>
      <outline type="rss" text="Seattle Now and Then" title="Seattle Now and Then" description="Local history, archival photographs, and present-day comparisons." xmlUrl="https://pauldorpat.com/feed/" htmlUrl="https://pauldorpat.com"/>
      <outline type="rss" text="Seattleite" title="Seattleite" description="Dining, travel, entertainment, and lifestyle coverage with a Seattle focus." xmlUrl="https://seattleite.com/feed/" htmlUrl="https://seattleite.com"/>
      <outline type="rss" text="The Seattle Star" title="The Seattle Star" description="Local arts, literature, comics, and cultural commentary." xmlUrl="https://www.seattlestar.net/feed/" htmlUrl="https://www.seattlestar.net"/>
    </outline>
    <outline text="Commentary and Advocacy" title="Commentary and Advocacy">
      <outline type="rss" text="DivestSPD" title="DivestSPD" description="Police accountability investigations and commentary from an advocacy perspective." xmlUrl="https://www.divestspd.com/feed" htmlUrl="https://www.divestspd.com"/>
      <outline type="rss" text="HorsesAss" title="HorsesAss" description="Progressive political commentary on Seattle, Washington, and national issues." xmlUrl="https://horsesass.org/feed/" htmlUrl="https://horsesass.org"/>
      <outline type="rss" text="NPI Cascadia Advocate" title="NPI Cascadia Advocate" description="Progressive political research, analysis, and advocacy for Washington and the wider Northwest." xmlUrl="https://www.nwprogressive.org/weblog/feed" htmlUrl="https://www.nwprogressive.org/weblog"/>
      <outline type="rss" text="Post Alley" title="Post Alley" description="Regional essays and commentary on politics, civic life, and culture, including national topics." xmlUrl="https://www.postalley.org/feed/" htmlUrl="https://www.postalley.org"/>
      <outline type="rss" text="Seattle Streets Alliance" title="Seattle Streets Alliance" description="Street safety and transportation advocacy from the organization formerly known as Seattle Neighborhood Greenways." xmlUrl="https://www.streetsalliance.org/feed/" htmlUrl="https://www.streetsalliance.org/get-involved/blog"/>
      <outline type="rss" text="Through the Static" title="Through the Static" description="Seattle community reporting and commentary with a focus on local activism." xmlUrl="https://throughthestatic.org/feed/" htmlUrl="https://throughthestatic.org"/>
      <outline type="rss" text="Transit Riders Union" title="Transit Riders Union" description="Transit access, labor campaigns, and political endorsements from a membership advocacy organization." xmlUrl="https://transitriders.org/feed/" htmlUrl="https://transitriders.org"/>
      <outline type="rss" text="West Seattle Bike Connections" title="West Seattle Bike Connections" description="Cycling advocacy, neighborhood rides, and safer-street campaigns." xmlUrl="https://westseattlebikeconnections.org/feed/" htmlUrl="https://westseattlebikeconnections.org"/>
    </outline>
    <outline text="Government and Public Services" title="Government and Public Services">
      <outline type="rss" text="City of Seattle News" title="City of Seattle News" description="Combined city department announcements; overlaps with the individual city feeds below." xmlUrl="https://news.seattle.gov/feed/" htmlUrl="https://news.seattle.gov"/>
      <outline type="rss" text="King County Library System" title="King County Library System" description="Library services, events, reading programs, and community announcements." xmlUrl="https://kcls.org/feed/" htmlUrl="https://kcls.org"/>
      <outline type="rss" text="King County Metro Matters" title="King County Metro Matters" description="Bus service changes, transit projects, and rider information from the transit agency." xmlUrl="https://kingcountymetro.blog/feed/" htmlUrl="https://kingcountymetro.blog"/>
      <outline type="rss" text="King County Parks Blog" title="King County Parks Blog" description="County parks, regional trails, recreation, and facilities updates." xmlUrl="https://kingcountyparks.org/feed/" htmlUrl="https://kingcountyparks.org"/>
      <outline type="rss" text="SDOT Blog" title="SDOT Blog" description="City transportation projects, street changes, and travel advisories." xmlUrl="https://sdotblog.seattle.gov/feed/" htmlUrl="https://sdotblog.seattle.gov"/>
      <outline type="rss" text="Seattle City Council Blog" title="Seattle City Council Blog" description="Council announcements and statements from elected officials." xmlUrl="https://council.seattle.gov/feed/" htmlUrl="https://council.seattle.gov"/>
      <outline type="rss" text="Seattle Economic Development Bottom Line" title="Seattle Economic Development Bottom Line" description="City economic-development programs, small-business support, and announcements." xmlUrl="https://bottomline.seattle.gov/feed/" htmlUrl="https://bottomline.seattle.gov"/>
      <outline type="rss" text="Seattle Human Interests" title="Seattle Human Interests" description="Human Services Department programs, funding, and community-service announcements." xmlUrl="https://humaninterests.seattle.gov/feed/" htmlUrl="https://humaninterests.seattle.gov"/>
      <outline type="rss" text="Seattle Parks Parkways" title="Seattle Parks Parkways" description="City parks, recreation programs, facilities, and service announcements." xmlUrl="https://parkways.seattle.gov/feed/" htmlUrl="https://parkways.seattle.gov"/>
      <outline type="rss" text="Seattle Police Blotter" title="Seattle Police Blotter" description="Police department incident reports and announcements; an agency account of events." xmlUrl="https://spdblotter.seattle.gov/feed/" htmlUrl="https://spdblotter.seattle.gov"/>
      <outline type="rss" text="Sound Transit Platform" title="Sound Transit Platform" description="Rail and bus projects, service information, and agency updates." xmlUrl="https://www.soundtransit.org/blog/platform/feed" htmlUrl="https://www.soundtransit.org"/>
      <outline type="rss" text="Washington Smoke Blog" title="Washington Smoke Blog" description="Seasonal wildfire-smoke and air-quality updates from participating public agencies." xmlUrl="https://wasmoke.blogspot.com/feeds/posts/default" htmlUrl="https://wasmoke.blogspot.com"/>
      <outline type="rss" text="Washington State House Democrats" title="Washington State House Democrats" description="Partisan legislative caucus announcements and news roundups from House Democrats." xmlUrl="https://housedemocrats.wa.gov/feed/" htmlUrl="https://housedemocrats.wa.gov"/>
      <outline type="rss" text="WSDOT Blog" title="WSDOT Blog" description="State highway projects, ferries, travel information, and transportation updates." xmlUrl="https://feeds.feedburner.com/wsdotblog" htmlUrl="https://wsdotblog.blogspot.com"/>
