      <outline type="rss" text="Downtown Bellevue Network" title="Downtown Bellevue Network" description="Downtown development, businesses, restaurants, and neighborhood news." xmlUrl="https://downtownbellevue.com/feed/" htmlUrl="https://downtownbellevue.com"/>
      <outline type="rss" text="Kirkland Reporter" title="Kirkland Reporter" description="Local reporting and regional news for Kirkland readers." xmlUrl="https://www.kirklandreporter.com/feed/" htmlUrl="https://www.kirklandreporter.com"/>
      <outline type="rss" text="Redmond Reporter" title="Redmond Reporter" description="Local reporting and regional news for Redmond readers." xmlUrl="https://www.redmond-reporter.com/feed/" htmlUrl="https://www.redmond-reporter.com"/>
      <outline type="rss" text="The Seattle Times Eastside" title="The Seattle Times Eastside" description="Reporting on communities east of Lake Washington; overlaps with other local sections." xmlUrl="https://www.seattletimes.com/eastside/feed/" htmlUrl="https://www.seattletimes.com/eastside"/>
    </outline>
    <outline text="North Sound" title="North Sound">
