      <outline type="rss" text="PhinneyWood" title="PhinneyWood" description="Phinney Ridge and Greenwood news, businesses, and community events." xmlUrl="https://phinneywood.com/feed/" htmlUrl="https://phinneywood.com"/>
      <outline type="rss" text="Wallyhood" title="Wallyhood" description="Wallingford neighborhood news, businesses, and community events." xmlUrl="https://www.wallyhood.org/feed/" htmlUrl="https://www.wallyhood.org"/>
      <outline type="rss" text="West Seattle Blog" title="West Seattle Blog" description="Neighborhood news, local government, transportation, and community events." xmlUrl="https://westseattleblog.com/feed/" htmlUrl="https://westseattleblog.com"/>
