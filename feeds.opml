      <outline type="rss" text="The Bulletin" title="The Bulletin" description="Reporting and commentary on Seattle Public Schools from an independent publication founded by progressive SPS parents." xmlUrl="https://thebulletinsea.org/rss/" htmlUrl="https://thebulletinsea.org"/>
      <outline type="rss" text="The Burner" title="The Burner" description="Seattle-area reporting and commentary on government and public accountability, with an explicitly left editorial outlook." xmlUrl="https://www.theburnerseattle.com/blog-feed.xml" htmlUrl="https://www.theburnerseattle.com"/>
